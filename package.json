{
  "license": "AGPL-3.0-or-later",
  "name": "@sdkwork/github-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Reusable GitHub Actions workflow framework for SDKWork application packaging and deployment.",
  "bin": {
    "agent-workflow": "./scripts/agent-workflow.mjs"
  },
  "scripts": {
    "stop": "node ../sdkwork-specs/tools/stop-sdkwork-workspace-processes.mjs --workspace .",
    "test": "node --test",
    "check": "pnpm test && node scripts/validate-repository.mjs && pnpm check:cors-standard && pnpm check:app-composition",
    "check:example": "node scripts/agent-workflow.mjs validate --config examples/sdkwork-cloudrouter/agent.workflow.json",
    "check:cors-standard": "node ../sdkwork-specs/tools/check-cors-standard.mjs --root .",
    "workflow:matrix:example": "node scripts/agent-workflow.mjs matrix --config examples/sdkwork-cloudrouter/agent.workflow.json --platform all --architecture all --profile all --format all --json",
    "check:app-composition": "node ../sdkwork-specs/tools/verify-repo.mjs --root .",
    "api:assembly:materialize": "node ../sdkwork-specs/tools/materialize-api-assembly.mjs --root .",
    "api:assembly:validate": "node ../sdkwork-specs/tools/validate-api-assembly.mjs --root .",
    "topology:validate": "node ../sdkwork-app-topology/scripts/sdkwork-topology.mjs validate --root . --spec specs/topology.spec.json"
  },
  "engines": {
    "node": ">=20.11.0"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  }
}
